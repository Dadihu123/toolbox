# .gitignore — Toolbox

# Rust
/src-tauri/target/
**/*.rs.bk

# Node — host UI build (Vite). The portable artifacts live in /dist/ (anchored
# above); the UI build output is /ui/dist/, which `/dist/` does not cover.
node_modules/
/dist/
/ui/dist/

# Local state — never commit a data directory
/data/
**/data/

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Scratch
*.log
/scratch/
*.png.bak
